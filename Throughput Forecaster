/* ---------- charts ---------- */
function mkChart(id,cfg){if(charts[id])charts[id].destroy();charts[id]=new Chart($(id).getContext("2d"),cfg);}
const GRID={color:"#eceef1"},TICK={color:"#6b7280",font:{size:11}};

function renderCharts(){
  const p=sim.p,f=sim.finished;
  const mn=f[0],mx=f[f.length-1];
  const labels=[],freq=[],cum=[];
  for(let w=mn;w<=mx;w++){
    labels.push(p.start?fmtDate(addDays(p.start,w*p.days)):"P"+w);
    const c=f.filter(x=>x===w).length;
    freq.push(c);
    cum.push(+(f.filter(x=>x<=w).length/f.length*100).toFixed(1));
  }
  mkChart("c-hist",{type:"bar",data:{labels,datasets:[{data:freq,backgroundColor:"#0b5cad",borderRadius:3}]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>c.parsed.y+" trials"}}},
      scales:{y:{beginAtZero:true,ticks:TICK,grid:GRID,title:{display:true,text:"Trials",color:"#6b7280"}},x:{ticks:TICK,grid:{display:false}}}}});

  mkChart("c-cum",{type:"line",data:{labels,datasets:[{data:cum,borderColor:"#137333",backgroundColor:"rgba(19,115,51,.10)",fill:true,tension:.25,pointRadius:2}]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>c.parsed.y+"% chance of finishing by then"}}},
      scales:{y:{beginAtZero:true,max:100,ticks:{...TICK,callback:v=>v+"%"},grid:GRID},x:{ticks:TICK,grid:{display:false}}}}});

  const hz=Math.min(MAXCOLS,Math.max(p.horizon,Math.ceil(mx)+2));
  const bl=[],b50=[],b05=[],b95=[];
  for(let c=0;c<=hz;c++){
    bl.push(p.start?fmtDate(addDays(p.start,c*p.days)):"P"+c);
    const col=sim.burn.map(r=>r[c]).sort((a,b)=>a-b);
    b50.push(Math.round(pct(col,.5)));b05.push(Math.round(pct(col,.05)));b95.push(Math.round(pct(col,.95)));
  }
  mkChart("c-burn",{type:"line",data:{labels:bl,datasets:[
    {label:"95th percentile",data:b95,borderColor:"#b3261e",backgroundColor:"rgba(179,38,30,.07)",fill:"+2",tension:.2,pointRadius:0,borderWidth:1.5},
    {label:"Median",data:b50,borderColor:"#0b5cad",tension:.2,pointRadius:0,borderWidth:2},
    {label:"5th percentile",data:b05,borderColor:"#137333",tension:.2,pointRadius:0,borderWidth:1.5}]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{boxWidth:12,font:{size:11}}}},
      scales:{y:{beginAtZero:true,ticks:TICK,grid:GRID,title:{display:true,text:"Stories remaining",color:"#6b7280"}},x:{ticks:TICK,grid:{display:false}}}}});

  const act=[];for(let i=0;i<=hz;i++)act.push(actuals[i]!==undefined?actuals[i]:null);
  mkChart("c-actuals",{type:"line",data:{labels:bl,datasets:[
    {label:"95th percentile",data:b95,borderColor:"#d9c2c0",backgroundColor:"rgba(11,92,173,.06)",fill:"+2",tension:.2,pointRadius:0,borderWidth:1},
    {label:"Median forecast",data:b50,borderColor:"#9aa0a6",borderDash:[5,4],tension:.2,pointRadius:0,borderWidth:1.5},
    {label:"5th percentile",data:b05,borderColor:"#c2d9c6",tension:.2,pointRadius:0,borderWidth:1},
    {label:"Actual remaining",data:act,borderColor:"#b3261e",backgroundColor:"#b3261e",tension:.15,pointRadius:4,borderWidth:2.5,spanGaps:false}]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{boxWidth:12,font:{size:11}}}},
      scales:{y:{beginAtZero:true,ticks:TICK,grid:GRID},x:{ticks:TICK,grid:{display:false}}}}});

  const bins={};sim.triDraws.forEach(v=>{const k=Math.round(v);bins[k]=(bins[k]||0)+1;});
  const bk=Object.keys(bins).map(Number).sort((a,b)=>a-b);
  mkChart("c-tri",{type:"bar",data:{labels:bk,datasets:[{data:bk.map(k=>bins[k]),backgroundColor:"#7a4bd8",borderRadius:3}]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},
      scales:{y:{beginAtZero:true,ticks:TICK,grid:GRID,title:{display:true,text:"Draws",color:"#6b7280"}},
        x:{ticks:TICK,grid:{display:false},title:{display:true,text:"Stories per period",color:"#6b7280"}}}}});

  const marks=[4,8,12,16,20,24,28,32,36,40,44,48,52];
  $("th-storygrid").innerHTML="<tr><th class='txt'>Confidence</th>"+marks.map(m=>`<th>${m} ${p.unitName}s</th>`).join("")+"</tr>";
  $("t-storygrid").innerHTML=[.95,.85,.5,.05].map(c=>{
    const cls=c===.85?' class="hl"':c===.95?' class="hl2"':"";
    return `<tr${cls}><td class="txt">${Math.round(c*100)}%</td>`+marks.map(m=>{
      const col=sim.tpTrials.map(t=>t[m-1]).sort((a,b)=>a-b);
      return `<td>${Math.round(pct(col,1-c))}</td>`;}).join("")+"</tr>";
  }).join("");
}

/* ---------- export ---------- */
function exportCSV(){
  const p=sim.p;
  let out="Trial,PeriodsToZero,EndDate,TotalStories,"+Array.from({length:MAXCOLS},(_,i)=>"P"+(i+1)).join(",")+"\n";
  sim.burn.forEach((row,i)=>{
    const w=sim.weeks[i];
    const d=(p.start&&w)?addDays(p.start,w*p.days).toISOString().slice(0,10):"";
    out+=[i+1,w??"",d,row[0],...row.slice(1).map(v=>Math.round(v))].join(",")+"\n";
  });
  const a=document.createElement("a");
  a.href=URL.createObjectURL(new Blob([out],{type:"text/csv"}));
  a.download="throughput_forecast_trials.csv";a.click();URL.revokeObjectURL(a.href);
}

