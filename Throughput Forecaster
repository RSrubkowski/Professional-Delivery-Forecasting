/* ---------- boot ---------- */
function fillSelects(){
  $("i-complex").innerHTML=COMPLEXITY.map(c=>`<option>${c[0]}</option>`).join("");
  $("i-unit").innerHTML=DURATIONS.map(d=>`<option>${d[0]}</option>`).join("");
  $("i-focus").innerHTML=FOCUS.map(f=>`<option>${f[0]}</option>`).join("");
}
function run(){
  sim=simulate(inputs());
  renderForecast();renderSamples();renderRisks();renderActuals();
